# --- required ---
# Random string, used in the webhook URL: http://tm6-converter:8000/convert/<WEBHOOK_SECRET>
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Mealie > Profile > API Tokens
MEALIE_API_TOKEN=

# OpenAI-compatible endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# json_schema | json_object | none   (json_object works almost everywhere)
LLM_JSON_MODE=json_object
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=300
# LLM_MAX_TOKENS=8000

# --- optional ---
MEALIE_URL=http://mealie:9000
MEALIE_PUBLIC_URL=https://mealie.tzetang.com
TM6_TAG=tm6
# Convert every newly created recipe (needs a Mealie notifier, see README)
AUTO_CONVERT_ENABLED=false
LOG_LEVEL=INFO
